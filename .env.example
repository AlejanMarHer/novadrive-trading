# Copia este archivo a `.env` (motor) y a `apps/web/.env.local` (dashboard) y rellena los valores.
# NUNCA subas el `.env` real al repositorio.

# --- Base de datos (Supabase / PostgreSQL) — motor y dashboard ---
# Conexión con pooler (puerto 6543) para la aplicación
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para `prisma db push`
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Telegram (solo motor) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Opcionales (solo motor) ---
# Puerto HTTP (Render lo define automáticamente)
# PORT=3000
# API de Binance (por defecto data-api.binance.vision y, si falla, api.binance.com)
# BINANCE_API_URL="https://data-api.binance.vision,https://api.binance.com"
# Keep-alive para el plan gratuito de Render. Por defecto usa RENDER_EXTERNAL_URL (Render la define).
# KEEPALIVE_URL="https://tu-servicio.onrender.com"
# KEEPALIVE=off
# Hora UTC del informe diario por Telegram (0-23) u "off"
# DAILY_REPORT_HOUR_UTC=12
