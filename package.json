{
  "name": "trading-bot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:engine": "npm run dev --workspace=apps/engine",
    "start:engine": "npm run start --workspace=apps/engine",
    "cycle": "npm run cycle --workspace=apps/engine",
    "dev:web": "npm run dev --workspace=apps/web",
    "backtest": "npm run backtest --workspace=apps/engine --",
    "test": "npm run test --workspace=apps/engine && tsx --test apps/web/lib/*.test.ts",
    "typecheck": "npm run typecheck --workspace=apps/engine",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "technicalindicators": "^3.1.0"
  }
}
